+static void dumpFloatRowStats(const char* tag, const float* ptr, int count) {
+    if (nullptr == ptr || count <= 0) {
+        return;
+    }
+    double sum = 0.0;
+    double absSum = 0.0;
+    double weighted = 0.0;
+    float minV = std::numeric_limits<float>::max();
+    float maxV = -std::numeric_limits<float>::max();
+    for (int i = 0; i < count; ++i) {
+        float v = ptr[i];
+        sum += v;
+        absSum += std::fabs(v);
+        weighted += v * static_cast<double>((i % 251) + 1);
+        minV = std::min(minV, v);
+        maxV = std::max(maxV, v);
+    }
+    MNN_PRINT(" %s{sum=%.9g abs=%.9g weighted=%.9g min=%.9g max=%.9g first=", tag, sum, absSum, weighted,
+              minV, maxV);
+    for (int i = 0; i < std::min(6, count); ++i) {
+        MNN_PRINT("%s%.6g", i == 0 ? "" : ",", ptr[i]);
+    }
+    MNN_PRINT("}");
+}
+
+static void dumpTensorRow0Stats(const char* prefix, const MNN::Tensor* tensor) {
+    if (nullptr == tensor || tensor->host<void>() == nullptr) {
+        return;
+    }
+    auto type = tensor->getType();
+    if (type.code != halide_type_float || type.bits != 32 || tensor->elementSize() <= 0) {
+        return;
+    }
+    int seqLen = 1;
+    if (tensor->dimensions() >= 2 && tensor->length(1) > 0 && tensor->length(1) <= 8) {
+        seqLen = tensor->length(1);
+    } else if (tensor->dimensions() >= 1 && tensor->length(0) > 0 && tensor->length(0) <= 8) {
+        seqLen = tensor->length(0);
+    }
+    int rowSize = tensor->elementSize() / seqLen;
+    if (rowSize <= 0) {
+        return;
+    }
+    MNN_PRINT(" %s_shape=[", prefix);
+    for (int i = 0; i < tensor->dimensions(); ++i) {
+        MNN_PRINT("%s%d", i == 0 ? "" : ",", tensor->length(i));
+    }
+    MNN_PRINT("] rowSize=%d", rowSize);
+    dumpFloatRowStats("row0", tensor->host<float>(), rowSize);
+}
+
+static std::string sanitizeDumpName(const std::string& text) {
+    std::string res = text;
+    for (auto& c : res) {
+        if (!std::isalnum(static_cast<unsigned char>(c))) {
+            c = '_';
+        }
+    }
+    return res;
+}
+
+static void dumpTensorRow0ToFile(const std::string& dir, const std::string& tag, const MNN::Tensor* tensor) {
+    if (dir.empty() || nullptr == tensor || tensor->host<void>() == nullptr) {
+        return;
+    }
+    auto type = tensor->getType();
+    if (type.code != halide_type_float || type.bits != 32 || tensor->elementSize() <= 0) {
+        return;
+    }
+    int seqLen = 1;
+    if (tensor->dimensions() >= 2 && tensor->length(1) > 0 && tensor->length(1) <= 8) {
+        seqLen = tensor->length(1);
+    } else if (tensor->dimensions() >= 1 && tensor->length(0) > 0 && tensor->length(0) <= 8) {
+        seqLen = tensor->length(0);
+    }
+    int rowSize = tensor->elementSize() / seqLen;
+    if (rowSize <= 0) {
+        return;
+    }
+    std::string path = dir + "/" + sanitizeDumpName(tag) + ".txt";
+    std::ofstream ofs(path);
+    if (!ofs.is_open()) {
+        return;
+    }
+    ofs << std::setprecision(9);
+    const float* ptr = tensor->host<float>();
+    for (int i = 0; i < rowSize; ++i) {
+        ofs << ptr[i] << "\n";
+    }
+}
+
+static void dumpTensorFullToFile(const std::string& dir, const std::string& tag, const MNN::Tensor* tensor) {
+    if (dir.empty() || nullptr == tensor || tensor->host<void>() == nullptr) {
+        return;
+    }
+    auto type = tensor->getType();
+    if (type.code != halide_type_float || type.bits != 32 || tensor->elementSize() <= 0) {
+        return;
+    }
+    std::string path = dir + "/" + sanitizeDumpName(tag) + "_full.txt";
+    std::ofstream ofs(path);
+    if (!ofs.is_open()) {
+        return;
+    }
+    ofs << "# shape=";
+    for (int i = 0; i < tensor->dimensions(); ++i) {
+        ofs << (i == 0 ? "[" : ",") << tensor->length(i);
+    }
+    ofs << "] elements=" << tensor->elementSize() << "\n";
+    ofs << std::setprecision(9);
+    const float* ptr = tensor->host<float>();
+    for (int i = 0; i < tensor->elementSize(); ++i) {
+        ofs << ptr[i] << "\n";
+    }
+}
