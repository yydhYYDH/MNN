+static std::string dumpVarShapeJson(const Express::VARP& var) {
+    auto info = var.get() ? var->getInfo() : nullptr;
+    std::string res = "[";
+    if (info != nullptr) {
+        for (size_t i = 0; i < info->dim.size(); ++i) {
+            res += std::to_string(info->dim[i]);
+            if (i + 1 < info->dim.size()) {
+                res += ",";
+            }
+        }
+    }
+    res += "]";
+    return res;
+}
+
+static const char* dumpVarDtype(const halide_type_t& type) {
+    if (type.code == halide_type_float && type.bits == 32) {
+        return "float32";
+    }
+    if (type.code == halide_type_int && type.bits == 32) {
+        return "int32";
+    }
+    if (type.code == halide_type_uint && type.bits == 8) {
+        return "uint8";
+    }
+    return "unsupported";
+}
+
+static bool dumpVarRawFile(const std::string& dir, const std::string& name, const Express::VARP& var) {
+    auto info = var.get() ? var->getInfo() : nullptr;
+    if (dir.empty() || info == nullptr || info->size <= 0) {
+        return false;
+    }
+    const char* dtype = dumpVarDtype(info->type);
+    if (std::string(dtype) == "unsupported") {
+        return false;
+    }
+    std::string rawPath = dir + "/" + name + ".raw";
+    std::ofstream raw(rawPath, std::ios::binary);
+    if (!raw.is_open()) {
+        return false;
+    }
+    if (info->type.code == halide_type_float && info->type.bits == 32) {
+        auto ptr = var->readMap<float>();
+        if (ptr == nullptr) {
+            return false;
+        }
+        raw.write(reinterpret_cast<const char*>(ptr), static_cast<std::streamsize>(info->size * sizeof(float)));
+    } else if (info->type.code == halide_type_int && info->type.bits == 32) {
+        auto ptr = var->readMap<int>();
+        if (ptr == nullptr) {
+            return false;
+        }
+        raw.write(reinterpret_cast<const char*>(ptr), static_cast<std::streamsize>(info->size * sizeof(int)));
+    } else if (info->type.code == halide_type_uint && info->type.bits == 8) {
+        auto ptr = var->readMap<uint8_t>();
+        if (ptr == nullptr) {
+            return false;
+        }
+        raw.write(reinterpret_cast<const char*>(ptr), static_cast<std::streamsize>(info->size * sizeof(uint8_t)));
+    }
+    raw.close();
+
+    std::ofstream meta(dir + "/" + name + ".json");
+    if (!meta.is_open()) {
+        return false;
+    }
+    meta << "{\n";
+    meta << "  \"name\": \"" << name << "\",\n";
+    meta << "  \"raw\": \"" << name << ".raw\",\n";
+    meta << "  \"dtype\": \"" << dtype << "\",\n";
+    meta << "  \"shape\": " << dumpVarShapeJson(var) << ",\n";
+    meta << "  \"size\": " << info->size << "\n";
+    meta << "}\n";
+    return true;
+}
+
+static void dumpForwardHandoffMeta(const std::string& dir, int callIdx, int seqLen, int seqLenKey, bool inDecode,
+                                   bool isAllLogits, int extraCount, int allSeqLen, int genSeqLen) {
+    std::ofstream meta(dir + "/call_" + std::to_string(callIdx) + "_forward.json");
+    if (!meta.is_open()) {
+        return;
+    }
+    meta << "{\n";
+    meta << "  \"call\": " << callIdx << ",\n";
+    meta << "  \"seq_len\": " << seqLen << ",\n";
+    meta << "  \"seq_len_key\": " << seqLenKey << ",\n";
+    meta << "  \"in_decode\": " << (inDecode ? "true" : "false") << ",\n";
+    meta << "  \"all_logits\": " << (isAllLogits ? "true" : "false") << ",\n";
+    meta << "  \"extra_count\": " << extraCount << ",\n";
+    meta << "  \"all_seq_len\": " << allSeqLen << ",\n";
+    meta << "  \"gen_seq_len\": " << genSeqLen << "\n";
+    meta << "}\n";
+}
+
+static bool shouldDumpOpRow0(const std::string& name, const std::string& type, int ordinal) {
+    const char* filterEnv = std::getenv("MNN_DUMP_OP_ROW0_FILTER");
+    if (filterEnv != nullptr && filterEnv[0] != '\0') {
+        std::string filter(filterEnv);
+        return name.find(filter) != std::string::npos || type.find(filter) != std::string::npos;
+    }
+    if (ordinal < 80) {
+        return true;
+    }
+    return name.find("attention") != std::string::npos || name.find("Attention") != std::string::npos ||
+           type.find("Attention") != std::string::npos || type.find("MatMul") != std::string::npos ||
+           type.find("RoPE") != std::string::npos;
+}
